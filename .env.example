REMNAWAVE_BASE_URL=https://vpn.example.com
REMNAWAVE_API_TOKEN=your-api-token-here

# Optional: API key for Caddy reverse proxy with custom path
# See: https://docs.remnawave.com/docs/security/caddy-with-custom-path/
# REMNAWAVE_API_KEY=your-caddy-api-key

# Mode. Support mode is the DEFAULT: 13 tools, one mutating operation
# (removing HWID devices), VPN credentials stripped from responses.
# Set to exactly "false" for unrestricted full access — any other value,
# including a typo or an empty string, keeps support mode.
# REMNAWAVE_IS_SUPPORT=false

# Optional: per-request timeout in milliseconds. Default 30000.
# A stalled panel would otherwise stall the caller's tool call for as long as
# the connection stays open. Junk or non-positive values fall back to the
# default rather than disabling the timeout.
# REMNAWAVE_TIMEOUT_MS=30000
